+static bool has_vpopcnt() {
+    static const bool ok = [] {
+#if defined(_MSC_VER)
+        int r[4];
+        __cpuidex(r, 7, 0);
+        return ((r[2] >> 14) & 1) != 0;   // AVX512_VPOPCNTDQ
+#else
+        unsigned a, b, c, d;
+        __cpuid_count(7, 0, a, b, c, d);
+        return ((c >> 14) & 1u) != 0;
+#endif
+    }();
+    return ok;
+}
+
+// C6 (local port sobre 0.1.48): la suma de signos por popcount tambien en IQ3_XXS para la lane de expertos nativos
+// (hasta ahora solo la usaba la lane de DeepSeek, iq512x_rows).  Opt-in: STRATA_IQ_POPCOUNT=1; ausente o 0 deja el
+// kernel de 0.1.48 byte a byte.  Nota: FmtX<18> siempre mira la rejilla con las busquedas escalares (no usa el gather
+// de STRATA_IQ_GATHER), asi que la bandera A/A cambia solo lo que se quiere medir: como se sacan las mascaras de signo.
+inline bool popcount_signs_ok() noexcept {
+    static const bool ok = [] {
+        const char* e = std::getenv("STRATA_IQ_POPCOUNT");
+        if (e == nullptr || *e == '0') return false;
+        if (!has_vpopcnt()) return false;
+        for (int i = 0; i < 128; ++i) {   // el atajo solo vale si la tabla es ksigns_iq2xs[i] = i | parity(i) << 7
+            unsigned p = 0;
+            for (unsigned x = (unsigned) i; x; x >>= 1) p ^= x & 1u;
+            if (ksigns_iq2xs[i] != (uint8_t) (i | (p << 7))) return false;
+        }
+        return true;
+    }();
+    return ok;
+}
