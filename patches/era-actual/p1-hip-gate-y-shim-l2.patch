diff --git a/engine/cmake/strata_gpu_engine.cmake b/engine/cmake/strata_gpu_engine.cmake
index 7db173282..e116acfef 100644
--- a/engine/cmake/strata_gpu_engine.cmake
+++ b/engine/cmake/strata_gpu_engine.cmake
@@ -776,19 +776,72 @@ if(STRATA_ENABLE_CUDA OR STRATA_ENABLE_HIP)
       set_tests_properties(mmvq_multi_parity_cuda_layout PROPERTIES ENVIRONMENT "STRATA_MMVQ_WAVE=0")
     endif()
   endif()
-  if(STRATA_ENABLE_CUDA)
-    # fork F4: the 2-4 column dense projections from the interleaved q8_1 copy, bitwise vs native_mmvq (GPU, synthetic)
+  if(STRATA_ENABLE_CUDA OR STRATA_ENABLE_HIP)
+    # fork F4: the 2-4 column dense projections from the interleaved q8_1 copy, bitwise vs native_mmvq (GPU, synthetic).
+    # Local divergence (Strata-upstream P1): the interleaved kernels build for HIP too, so the parity test runs there.
     add_executable(mmvq_il_parity src/kernels/mmvq_il_parity.cpp)
     target_include_directories(mmvq_il_parity PRIVATE ${_strata_gpu_include_directories})
     target_link_libraries(mmvq_il_parity PRIVATE strata_kernels ${_strata_gpu_runtime_target})
     add_test(NAME mmvq_il_parity COMMAND mmvq_il_parity)
-    # sm_89's opt-in tables (#3453, STRATA_MMVQ_IL_89=1): the table check only (no case matches MMVQ_IL_ONLY)
-    add_test(NAME mmvq_il_parity_89table COMMAND mmvq_il_parity)
-    set_tests_properties(mmvq_il_parity_89table PROPERTIES ENVIRONMENT "STRATA_MMVQ_IL_89=1;MMVQ_IL_ONLY=no-such-case")
-    # the opt-in STRATA_MMVQ_IL_PF kernels (hoisted group loads, exact integer forms): every variant bit-checked against
-    # native_mmvq for every type, shape, T and rows choice
-    add_test(NAME mmvq_il_parity_pf COMMAND mmvq_il_parity --pf 0,2,3,4,5,6)
-    set_tests_properties(mmvq_il_parity_pf PROPERTIES TIMEOUT 900)
+    if(STRATA_ENABLE_HIP)
+      set(_strata_il_parity_hip_l2 "${CMAKE_CURRENT_BINARY_DIR}/mmvq_il_parity_hip_l2.h")
+      # mmvq_il_parity's --persist and --ab arms read NVIDIA's L2 set-aside APIs, which hip_compat does not map and HIP
+      # has no forms of, so the file's own #if !defined(STRATA_HIP_GFX906) gates are not enough for a wave32 AMD build.
+      file(GENERATE OUTPUT "${_strata_il_parity_hip_l2}" CONTENT "
+// generated by strata_gpu_engine.cmake for mmvq_il_parity on HIP (the L2 set-aside names its --persist / --ab arms call).
+#pragma once
+#include <hip/hip_runtime.h>
+#ifndef cudaDevAttrL2CacheSize
+#define cudaDevAttrL2CacheSize hipDeviceAttributeL2CacheSize
+#endif
+#ifndef cudaDeviceSetLimit
+#define cudaDeviceSetLimit hipDeviceSetLimit
+#endif
+#ifndef cudaDeviceGetLimit
+#define cudaDeviceGetLimit hipDeviceGetLimit
+#endif
+#ifndef cudaStreamSetAttribute
+#define cudaStreamSetAttribute hipStreamSetAttribute
+#endif
+#ifndef cudaStreamAttributeAccessPolicyWindow
+#define cudaStreamAttributeAccessPolicyWindow hipStreamAttributeAccessPolicyWindow
+#endif
+#ifndef cudaStreamAttrValue
+#define cudaStreamAttrValue hipStreamAttrValue
+#endif
+#ifndef cudaAccessPropertyPersisting
+#define cudaAccessPropertyPersisting hipAccessPropertyPersisting
+#endif
+#ifndef cudaAccessPropertyStreaming
+#define cudaAccessPropertyStreaming hipAccessPropertyStreaming
+#endif
+// AMD wave32 has no persisting-L2 limit and no access-policy attributes: ids its runtime answers as an unsupported
+// limit and as invalid attributes.
+#ifndef cudaDevAttrMaxPersistingL2CacheSize
+#define cudaDevAttrMaxPersistingL2CacheSize ((hipDeviceAttribute_t) -1)
+#endif
+#ifndef cudaDevAttrMaxAccessPolicyWindowSize
+#define cudaDevAttrMaxAccessPolicyWindowSize ((hipDeviceAttribute_t) -1)
+#endif
+#ifndef cudaLimitPersistingL2CacheSize
+#define cudaLimitPersistingL2CacheSize ((hipLimit_t) 0x03)
+#endif
+")
+      target_compile_options(mmvq_il_parity PRIVATE
+        "$<$<COMPILE_LANGUAGE:CXX>:SHELL:-include ${_strata_il_parity_hip_l2}>")
+    endif()
+    if(STRATA_ENABLE_CUDA)
+      # sm_89's opt-in tables (#3453, STRATA_MMVQ_IL_89=1): the table check only (no case matches MMVQ_IL_ONLY)
+      add_test(NAME mmvq_il_parity_89table COMMAND mmvq_il_parity)
+      set_tests_properties(mmvq_il_parity_89table PROPERTIES ENVIRONMENT "STRATA_MMVQ_IL_89=1;MMVQ_IL_ONLY=no-such-case")
+      # the opt-in STRATA_MMVQ_IL_PF kernels (hoisted group loads, exact integer forms): every variant bit-checked against
+      # native_mmvq for every type, shape, T and rows choice.  CUDA only: the pf kernels' address arithmetic is PTX
+      # (native_mmvq.cu's STRATA_IL_PF), so a HIP build runs native_mmvq_il_kernel for every variant and measures nothing.
+      add_test(NAME mmvq_il_parity_pf COMMAND mmvq_il_parity --pf 0,2,3,4,5,6)
+      set_tests_properties(mmvq_il_parity_pf PROPERTIES TIMEOUT 900)
+    endif()
+  endif()
+  if(STRATA_ENABLE_CUDA)
     # the wide dequant kernels (a thread per 8 values; sm_61's default), bitwise vs the per-group ones (GPU, synthetic,
     # no model; --bench adds old/new timings)
     add_executable(dequant_wide_parity src/kernels/dequant_wide_parity.cpp)
