new file mode 100644
index 000000000..6b629eef3
--- /dev/null
+++ b/terminal/serve/test_image_ssrf.py
@@ -0,0 +1,166 @@
+"""Image URLs: a URL that points at this PC itself (127.0.0.1, ::1), at a link-local address (169.254.169.254, fe80::),
+at multicast or at the unspecified address is refused before anything connects, and so is every redirect destination
+(a public host that answers 302 with `Location: http://127.0.0.1:8081/status` used to take the server there: the audit's
+third finding).  A LAN address (10/8, 172.16/12, 192.168/16) is allowed on purpose: this is a home server, and a
+picture on another machine of one's own network is a normal thing to send.  The refusal goes to the window; the client
+gets `the image URL could not be read`, unless STRATA_VERBOSE_ERRORS=1.
+
+    python -m unittest serve.test_image_ssrf -v
+"""
+import os
+import threading
+import unittest
+import urllib.error
+import urllib.request
+from unittest import mock
+
+from serve.server import ImageRedirects, UrlRefused, Vision, image_url_allow_internal, image_url_refusal
+
+REFUSED = (
+    "http://127.0.0.1:1/x.png",                          # loopback, IPv4
+    "http://127.0.0.2/x.png",                            # the whole 127/8 is loopback
+    "http://[::1]:8081/x.png",                           # loopback, IPv6
+    "http://localhost:1/x.png",                          # the name of the loopback address
+    "http://169.254.169.254/latest/meta-data/",          # link-local (the cloud metadata address)
+    "http://[fe80::1]/x.png",                            # link-local, IPv6
+    "http://224.0.0.1/x.png",                            # multicast
+    "http://0.0.0.0/x.png",                              # unspecified
+)
+
+ALLOWED = (
+    "http://192.168.0.35:8081/status",                   # this server's own LAN address: allowed on purpose
+    "http://10.0.0.5/x.png",
+    "http://172.16.9.9/x.png",
+    "http://1.1.1.1/x.png",
+)
+
+
+class Refusal(unittest.TestCase):
+    def test_internal_urls_are_refused(self):
+        for url in REFUSED:
+            with self.subTest(url=url):
+                self.assertIsNotNone(image_url_refusal(url))
+
+    def test_lan_urls_are_allowed(self):
+        for url in ALLOWED:
+            with self.subTest(url=url):
+                self.assertIsNone(image_url_refusal(url))
+
+    def test_a_name_that_resolves_to_loopback_is_refused(self):
+        """Through getaddrinfo, not through the spelling: a name (or a decimal address) that answers 127.0.0.1 is the
+        same thing as 127.0.0.1."""
+        for url in ("http://2130706433/x.png", "http://127.1/x.png"):
+            with self.subTest(url=url):
+                self.assertIsNotNone(image_url_refusal(url))
+
+    def test_the_switch_allows_the_pc_itself(self):
+        for url in ("http://127.0.0.1:1/x.png", "http://[::1]/x.png", "http://169.254.169.254/x.png"):
+            with self.subTest(url=url):
+                self.assertIsNone(image_url_refusal(url, allow_internal=True))
+        self.assertIsNotNone(image_url_refusal("http://224.0.0.1/x.png", allow_internal=True))
+
+    def test_the_switch_is_the_environment_variable(self):
+        with mock.patch.dict(os.environ, {}, clear=False):
+            os.environ.pop("STRATA_IMAGE_URL_ALLOW_INTERNAL", None)
+            self.assertFalse(image_url_allow_internal())
+        for value, expected in (("1", True), ("true", True), ("yes", True), ("0", False), ("", False)):
+            with self.subTest(value=value), mock.patch.dict(os.environ, {"STRATA_IMAGE_URL_ALLOW_INTERNAL": value}):
+                self.assertEqual(image_url_allow_internal(), expected)
+
+    def test_a_url_without_a_host_is_refused(self):
+        self.assertIsNotNone(image_url_refusal("http:///x.png"))
+
+    def test_a_host_that_does_not_resolve_is_refused(self):
+        import socket
+        with mock.patch("serve.server.socket.getaddrinfo", side_effect=socket.gaierror("no such host")):
+            self.assertIsNotNone(image_url_refusal("http://no-such-host.invalid/x.png"))
+
+
+class Redirects(unittest.TestCase):
+    def test_a_redirect_to_loopback_is_refused(self):
+        handler = ImageRedirects()
+        with self.assertRaises(UrlRefused):
+            handler.redirect_request(urllib.request.Request("http://example.com/x.png"), None, 302, "Found", {},
+                                     "http://127.0.0.1:8081/status")
+
+    def test_a_redirect_to_a_lan_address_is_allowed(self):
+        handler = ImageRedirects()
+        out = handler.redirect_request(urllib.request.Request("http://example.com/x.png"), None, 302, "Found", {},
+                                       "http://10.0.0.5/x.png")
+        self.assertIsNotNone(out)
+
+    def test_at_most_three_hops(self):
+        self.assertEqual(ImageRedirects.max_redirections, 3)
+
+
+class OverHttp(unittest.TestCase):
+    """The refusal as the client sees it: one sentence (no port, no errno), the reason only in the window, and 400."""
+
+    def server(self, to: str = ""):
+        """A tiny HTTP server of its own on 127.0.0.1 (so the tests turn the switch on): /img is a picture, /hop is a
+        redirect to `to`, /loopN redirects to /loopN+1 for ever."""
+        import http.server
+
+        class Files(http.server.BaseHTTPRequestHandler):
+            def log_message(self, *a):
+                pass
+
+            def do_GET(self):
+                if self.path == "/hop" and to:
+                    self.send_response(302)
+                    self.send_header("Location", to)
+                    self.end_headers()
+                    return
+                if self.path.startswith("/loop"):
+                    n = int(self.path[len("/loop"):] or "0")
+                    self.send_response(302)
+                    self.send_header("Location", f"/loop{n + 1}")
+                    self.end_headers()
+                    return
+                body = b"\x89PNG\r\n\x1a\n" + b"x" * 32
+                self.send_response(200)
+                self.send_header("Content-Length", str(len(body)))
+                self.end_headers()
+                self.wfile.write(body)
+
+        httpd = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Files)
+        threading.Thread(target=httpd.serve_forever, daemon=True).start()
+        return httpd
+
+    def test_an_internal_url_never_connects(self):
+        with self.assertRaisesRegex(ValueError, "^the image URL could not be read$"):
+            Vision.download("http://127.0.0.1:1/x.png")
+
+    def test_a_refusal_says_why_with_the_switch_on(self):
+        with mock.patch.dict(os.environ, {"STRATA_VERBOSE_ERRORS": "1"}):
+            with self.assertRaisesRegex(ValueError, "STRATA_IMAGE_URL_ALLOW_INTERNAL=1 allows it"):
+                Vision.download("http://127.0.0.1:1/x.png")
+
+    def test_the_switch_lets_a_local_server_be_read(self):
+        httpd = self.server("")
+        try:
+            base = f"http://127.0.0.1:{httpd.server_address[1]}"
+            with mock.patch.dict(os.environ, {"STRATA_IMAGE_URL_ALLOW_INTERNAL": "1"}):
+                self.assertTrue(Vision.download(base + "/img").startswith(b"\x89PNG"))
+                with mock.patch.dict(os.environ, {}, clear=False):     # and off again, the same URL is refused
+                    os.environ.pop("STRATA_IMAGE_URL_ALLOW_INTERNAL", None)
+                    with self.assertRaisesRegex(ValueError, "^the image URL could not be read$"):
+                        Vision.download(base + "/img")
+        finally:
+            httpd.shutdown()
+            httpd.server_close()
+
+    def test_a_local_server_that_redirects_is_read_and_an_endless_one_is_cut(self):
+        httpd = self.server("")
+        try:
+            base = f"http://127.0.0.1:{httpd.server_address[1]}"
+            with mock.patch.dict(os.environ, {"STRATA_IMAGE_URL_ALLOW_INTERNAL": "1", "STRATA_VERBOSE_ERRORS": "1"}):
+                with self.assertRaisesRegex(ValueError, "could not be read"):
+                    Vision.download(base + "/loop")                    # 3 hops is the limit
+        finally:
+            httpd.shutdown()
+            httpd.server_close()
+
+
+if __name__ == "__main__":
+    unittest.main()
