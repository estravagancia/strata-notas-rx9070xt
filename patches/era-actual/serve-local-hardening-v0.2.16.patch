+"""The local image file bound: a picture read from this computer is at most IMAGE_URL_MAX (32 MiB, the same bound as a
+picture read from a URL, `STRATA_MAX_IMAGE_FILE_MIB` changes it), and with "image_dir" in the vision section only files
+inside that directory are read.  Before the bound, a shard or a backup named .png was read whole into the server's
+memory (Path.read_bytes, no size looked at).
+
+    python -m unittest serve.test_image_file_limits -v
+"""
+import http.client
+import json
+import os
+import shutil
+import tempfile
+import time
+import unittest
+from pathlib import Path
+from unittest import mock
+
+from serve.frontend import ChatTemplate
+from serve.server import ByteTokenizer, MockEngine, Service, Vision, image_file_limit, serve
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+class FileLimits(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.dir = Path(self.tmp.name)
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def sparse(self, name: str, mib: int) -> Path:
+        """A file of `mib` MiB that costs no disk: its bytes are never written (the size is what is checked)."""
+        p = self.dir / name
+        with open(p, "wb") as f:
+            f.truncate(mib << 20)
+        return p
+
+    def test_the_default_bound_is_the_url_bound(self):
+        with mock.patch.dict(os.environ, {}, clear=False):
+            os.environ.pop("STRATA_MAX_IMAGE_FILE_MIB", None)
+            self.assertEqual(image_file_limit(), 32 << 20)
+        with mock.patch.dict(os.environ, {"STRATA_MAX_IMAGE_FILE_MIB": "junk"}):
+            self.assertEqual(image_file_limit(), 32 << 20)
+
+    def test_a_file_over_the_bound_is_refused_before_it_is_read(self):
+        p = self.sparse("big.png", 40)
+        with mock.patch.object(Path, "read_bytes") as read, self.assertRaisesRegex(ValueError, "over 32 MiB"):
+            Vision.load(str(p))
+        read.assert_not_called()
+
+    def test_a_shard_named_png_is_refused_at_once(self):
+        p = self.sparse("shard.png", 400)
+        t0 = time.monotonic()
+        with self.assertRaisesRegex(ValueError, "over 32 MiB"):
+            Vision.load(str(p))
+        self.assertLess(time.monotonic() - t0, 0.5)               # a size is read, not 400 MiB of bytes
+
+    def test_the_bound_can_be_raised_and_lowered(self):
+        p = self.sparse("two.png", 2)
+        with mock.patch.dict(os.environ, {"STRATA_MAX_IMAGE_FILE_MIB": "1"}):
+            with self.assertRaisesRegex(ValueError, "over 1 MiB"):
+                Vision.load(str(p))
+        with mock.patch.dict(os.environ, {"STRATA_MAX_IMAGE_FILE_MIB": "4"}):
+            self.assertEqual(len(Vision.load(str(p))), 2 << 20)
+
+    def test_image_dir_is_the_only_root_when_it_is_set(self):
+        inside = self.dir / "inside"
+        inside.mkdir()
+        ok = inside / "x.png"
+        ok.write_bytes(b"\x89PNG\r\n\x1a\n")
+        outside = self.dir / "y.png"
+        outside.write_bytes(b"x")
+        root = os.path.realpath(inside)
+        self.assertEqual(Vision.load(str(ok), root), b"\x89PNG\r\n\x1a\n")
+        with self.assertRaisesRegex(ValueError, 'outside "image_dir"'):
+            Vision.load(str(outside), root)
+        with self.assertRaisesRegex(ValueError, 'outside "image_dir"'):     # ".." is resolved first
+            Vision.load(str(inside / ".." / "y.png"), root)
+
+    def test_a_link_that_leaves_the_root_is_refused(self):
+        inside = self.dir / "inside"
+        inside.mkdir()
+        secret = self.dir / "secret.png"
+        secret.write_bytes(b"x")
+        link = inside / "link.png"
+        link.symlink_to(secret)
+        with self.assertRaisesRegex(ValueError, 'outside "image_dir"'):
+            Vision.load(str(link), os.path.realpath(inside))
+
+    def test_without_image_dir_a_readable_file_is_read_as_before(self):
+        p = self.dir / "x.png"
+        p.write_bytes(b"\x89PNG\r\n\x1a\n")
+        self.assertEqual(Vision.load(str(p)), b"\x89PNG\r\n\x1a\n")
+
+    def test_the_vision_section_puts_the_root_where_encode_reads_it(self):
+        cfg = {"exe": "x", "mmproj": "m", "model": "w", "image_dir": str(self.dir)}
+        v = Vision(cfg, lazy=True)
+        try:
+            self.assertEqual(v.image_dir, os.path.realpath(self.dir))
+        finally:
+            v.shutdown()
+
+    def test_a_missing_image_dir_is_refused_at_startup(self):
+        cfg = {"exe": "x", "mmproj": "m", "model": "w", "image_dir": str(self.dir / "nope")}
+        with self.assertRaisesRegex(RuntimeError, "not a directory"):
+            Vision(cfg, lazy=True)
+
+
+class OverHttp(unittest.TestCase):
+    """The same bound over HTTP: a local path too big or outside "image_dir" is a 400 that says why (not a 500, not a
+    dropped connection), and one inside it still answers."""
+
+    class FakeVision:
+        """encode() is the real check (Vision.load) with no encoder process behind it; what it returns is not read by
+        MockEngine."""
+
+        def __init__(self, root):
+            self.image_dir = root
+            self.dir = Path(tempfile.mkdtemp(prefix="strata-rows-"))
+            self.rows = self.dir / "img.sve"
+            self.rows.write_bytes(b"rows")
+
+        def encode(self, source):
+            Vision.load(source, self.image_dir)
+            return self.rows, 3
+
+    @classmethod
+    def setUpClass(cls):
+        tok = ByteTokenizer()
+        cls.root = Path(tempfile.mkdtemp(prefix="strata-pictures-"))
+        cls.vision = cls.FakeVision(os.path.realpath(cls.root))
+        svc = Service(MockEngine(tok, "hello there", max_context=4096), tok,
+                      ChatTemplate(ROOT / "serve/chat_template.jinja"), vision=cls.vision)
+        cls.httpd = serve(svc, port=0)
+        cls.port = cls.httpd.server_address[1]
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.httpd.shutdown()
+        cls.httpd.server_close()
+        shutil.rmtree(cls.vision.dir, ignore_errors=True)
+        shutil.rmtree(cls.root, ignore_errors=True)
+
+    def ask(self, path: Path):
+        body = json.dumps({"messages": [{"role": "user", "content": [
+            {"type": "image_url", "image_url": {"url": "file://" + str(path)}}, {"type": "text", "text": "what is it?"}]}],
+            "max_tokens": 4})
+        c = http.client.HTTPConnection("127.0.0.1", self.port, timeout=30)
+        try:
+            c.request("POST", "/v1/chat/completions", body, {"Content-Type": "application/json"})
+            r = c.getresponse()
+            return r.status, r.read().decode(errors="replace")
+        finally:
+            c.close()
+
+    def test_a_big_file_is_a_400(self):
+        big = self.root / "big.png"
+        with open(big, "wb") as f:
+            f.truncate(40 << 20)
+        status, out = self.ask(big)
+        self.assertEqual(status, 400, out)
+        self.assertIn("over 32 MiB", out)
+
+    def test_a_file_outside_image_dir_is_a_400(self):
+        outside = Path(tempfile.mkdtemp(prefix="strata-elsewhere-")) / "x.png"
+        outside.write_bytes(b"\x89PNG\r\n\x1a\n")
+        try:
+            status, out = self.ask(outside)
+        finally:
+            shutil.rmtree(outside.parent, ignore_errors=True)
+        self.assertEqual(status, 400, out)
+        self.assertIn("is outside", out)                          # the JSON escapes the quotes of "image_dir"
+        self.assertIn("image_dir", out)
+
+    def test_a_file_inside_image_dir_answers(self):
+        ok = self.root / "x.png"
+        ok.write_bytes(b"\x89PNG\r\n\x1a\n")
+        status, out = self.ask(ok)
+        self.assertEqual(status, 200, out)
+
+
+if __name__ == "__main__":
