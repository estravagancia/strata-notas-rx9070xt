diff --git a/terminal/serve/test_image_bombs.py b/terminal/serve/test_image_bombs.py
new file mode 100644
index 000000000..5201ff75c
--- /dev/null
+++ b/terminal/serve/test_image_bombs.py
@@ -0,0 +1,84 @@
+"""A JPEG that declares gigapixels in its frame header: Pillow reads that size in Image.open and refuses the image as a
+decompression bomb, and `Vision._exif_rotated` used to catch that refusal with a bare `except Exception` and answer
+"not rotated" - which sent the bytes down the passthrough path, where strata-vision's decoder (stb_image) has no bound
+of its own.  A few hundred bytes of JPEG could ask for hundreds of gigapixels of memory (the audit's finding).
+
+Now the refusal is a ValueError (a 400) from the same place.  What is NOT covered here: a PNG/BMP/GIF that goes
+passthrough without Pillow touching it (step 3, point 3: `image_dimensions()` and the number that comes out of the
+measurement window), and a JPEG of a size Pillow only warns about (89-179 MP, `test_between_the_warning_and_the_error`).
+
+    python -m unittest serve.test_image_bombs -v
+"""
+import io
+import unittest
+import warnings
+
+from PIL import Image
+
+from serve.server import Vision
+
+
+def declared_jpeg(width: int, height: int) -> bytes:
+    """A JPEG of 633 bytes that declares `width`x`height`: a real 8x8 JPEG with the two size fields of its SOF0 frame
+    header rewritten, so it is a header Pillow reads and its own bomb check refuses before anything decodes."""
+    buf = io.BytesIO()
+    Image.new("RGB", (8, 8), (255, 0, 0)).save(buf, format="JPEG")
+    data = bytearray(buf.getvalue())
+    sof = data.index(b"\xff\xc0")                       # SOF0: FF C0 len(2) precision(1) height(2) width(2)
+    assert sof < data.index(b"\xff\xda"), "SOF0 comes before the scan in a baseline JPEG"
+    data[sof + 5:sof + 7] = height.to_bytes(2, "big")
+    data[sof + 7:sof + 9] = width.to_bytes(2, "big")
+    return bytes(data)
+
+
+class Bombs(unittest.TestCase):
+    def test_the_fixture_is_a_bomb_by_pillows_own_check(self):
+        """What the finding is about: Pillow refuses these bytes (and the old bare except turned that into "not
+        rotated")."""
+        with self.assertRaises(Image.DecompressionBombError):
+            Image.open(io.BytesIO(declared_jpeg(30000, 30000)))
+
+    def test_the_refusal_is_a_400_and_not_a_passthrough(self):
+        with self.assertRaisesRegex(ValueError, "the image is too large to read"):
+            Vision.normalize(declared_jpeg(30000, 30000))
+
+    def test_the_exif_read_raises_instead_of_answering_false(self):
+        """The exact regression: False here meant "not rotated", and normalize() passed the bytes through."""
+        with self.assertRaisesRegex(ValueError, "the image is too large to read"):
+            Vision._exif_rotated(declared_jpeg(60000, 60000))
+
+    def test_the_bytes_are_not_decoded_to_decide(self):
+        """The verdict comes from the header: the same bytes are refused, and no pixels are read (the file is 633 bytes
+        and declares 60000x60000, so decoding it is what must not happen)."""
+        bomb = declared_jpeg(60000, 60000)
+        self.assertLess(len(bomb), 4096)
+        with self.assertRaises(ValueError):
+            Vision.normalize(bomb)
+
+    def test_an_ordinary_jpeg_still_passes_through(self):
+        self.assertEqual(Vision.normalize(declared_jpeg(8, 8)), declared_jpeg(8, 8))
+
+    def test_a_corrupt_jpeg_is_still_left_as_it_was(self):
+        """#1229: a tag that cannot be read must not turn a picture the decoder handles into a 400."""
+        corrupt = b"\xff\xd8\xff" + b"zzz"
+        self.assertFalse(Vision._exif_rotated(corrupt))
+        self.assertEqual(Vision.normalize(corrupt), corrupt)
+
+    def test_a_png_is_still_passthrough_for_now(self):
+        """Documented gap, not a bug fixed here: a PNG (or BMP/GIF) never reaches Pillow in normalize(), so its size is
+        what step 3 point 3 has to check before the bytes go to the decoder."""
+        png = b"\x89PNG\r\n\x1a\n" + b"\x00" * 16
+        self.assertEqual(Vision.normalize(png), png)
+
+    def test_between_the_warning_and_the_error(self):
+        """Pillow warns above 89 MP and refuses above twice that (~179 MP): in between, today, the bytes still go
+        passthrough.  The bound of the server's own comes out of the measurement (D2), which is why this test states the
+        current behavior instead of asserting a number."""
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore")                    # Pillow's DecompressionBombWarning
+            self.assertEqual(Vision.normalize(declared_jpeg(10000, 10000)),
+                             declared_jpeg(10000, 10000))
+
+
+if __name__ == "__main__":
+    unittest.main()
