+class ImageRedirects(urllib.request.HTTPRedirectHandler):
+    """At most 3 hops, and every hop's destination is checked like the first one.  Without this a host that answers 302
+    with `Location: http://127.0.0.1:8081/status` took the server to its own endpoints (the audit's third finding),
+    since only the original URL had been looked at."""
