+def image_url_refusal(url: str, allow_internal: bool | None = None) -> str | None:
+    """Why `url` must not be read, or None when it may be.  Refused: the loopback and the link-local addresses
+    (127.0.0.1, ::1, 169.254.169.254, fe80::), multicast and the unspecified address.  A LAN address (10/8,
+    172.16/12, 192.168/16) is allowed: this is a home server, and a picture on another machine of one's own network is
+    a normal thing to send.  Every address the host resolves to is checked, so a name whose DNS says 127.0.0.1 is
+    refused like the address itself."""
+    if allow_internal is None:
+        allow_internal = image_url_allow_internal()
+    parts = urlsplit(url)
+    if not parts.hostname:
+        return "the URL names no host"
+    port = parts.port or (443 if parts.scheme == "https" else 80)
+    try:
+        infos = socket.getaddrinfo(parts.hostname, port, proto=socket.IPPROTO_TCP)
+    except (socket.gaierror, UnicodeError, ValueError) as e:
+        return f"its host could not be resolved ({e})"
+    import ipaddress
+    for info in infos:                                  # str/bytes of the address, per family
+        try:
+            ip = ipaddress.ip_address(info[4][0])
+        except ValueError:
+            continue
+        if ip.is_multicast or ip.is_unspecified:
+            return f"{parts.hostname} is {ip}, which is not a machine"
+        if not allow_internal and (ip.is_loopback or ip.is_link_local):
+            return (f"{parts.hostname} is {ip} (this PC itself, or a link-local address): "
+                    f"STRATA_IMAGE_URL_ALLOW_INTERNAL=1 allows it")
+    return None
+
