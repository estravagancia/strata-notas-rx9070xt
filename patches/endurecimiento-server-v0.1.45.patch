+class HeaderTimeout(unittest.TestCase):
+    """A connection that opens and says nothing is closed by the headers' read timeout; a body that arrives slowly is
+    not.  The 12 half-sent connections that stayed open in the audit are the first test, here at 8 sockets."""
+
+    @classmethod
+    def setUpClass(cls):
+        tok = ByteTokenizer()
+        cls.svc = Service(MockEngine(tok, "hello there", max_context=4096), tok,
+                          ChatTemplate(ROOT / "serve/chat_template.jinja"))
+        cls.httpd = serve(cls.svc, port=0)
+        cls.port = cls.httpd.server_address[1]
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.httpd.shutdown()
+        cls.httpd.server_close()
+
+    def silent(self) -> float:
+        """Seconds until the server closes a socket that sent a request line that never ends, with the headers'
+        timeout patched.  -1 when it stayed open for the whole 3 s of the wait."""
+        s = socket.create_connection(("127.0.0.1", self.port), timeout=10)
+        try:
+            s.sendall(b"GET /health HT")                      # half a request line, then nothing
+            s.settimeout(3)
+            t0 = time.monotonic()
+            try:
+                if s.recv(1) != b"":
+                    raise AssertionError("the server answered a connection that sent no request")
+            except socket.timeout:
+                return -1.0
+            return time.monotonic() - t0
+        finally:
+            s.close()
+
+    def test_connections_that_say_nothing_are_closed(self):
+        with mock.patch("serve.server.REQUEST_HEADERS_S", 1.0):
+            for _ in range(8):                                # as many as the audit opened at once
+                closed = self.silent()
+                with self.subTest():
+                    self.assertGreaterEqual(closed, 0.9, "closed before its timeout, or not closed at all")
+                    self.assertLess(closed, 2.5, "the 1 s timeout did not close it")
+
+    def test_waiting_for_ever_is_what_0_means(self):
+        with mock.patch("serve.server.REQUEST_HEADERS_S", None):
+            self.assertEqual(self.silent(), -1.0, "0 must keep the old behaviour: the connection stays open")
