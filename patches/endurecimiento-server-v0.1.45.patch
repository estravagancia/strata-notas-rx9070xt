+class RocmInstalledRecord(unittest.TestCase):
+    """rocm_installs / rocm_stamp: what the wheels really installed, recorded where a later run can compare it.
+    TheRock's index publishes no hash for its wheels, so the fingerprint is pip's own per-file RECORD."""
+
+    def sitepackages(self, tmp, dists):
+        """A fake .venv site-packages with the RECORD files pip would have left (name -> RECORD contents)."""
+        sp = Path(tmp) / "site-packages"
+        for name, record in dists.items():
+            info = sp / name
+            info.mkdir(parents=True)
+            if record is not None:
+                (info / "RECORD").write_text(record, encoding="utf-8")
+        return sp
+
+    def read(self, sp):
+        with mock.patch.object(sys, "path", [str(sp), str(sp.parent / "lib")]):
+            return setup.rocm_installs()
+
+    def test_names_versions_and_record_hashes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            sp = self.sitepackages(tmp, {
+                "rocm-7.10.0a20251120.dist-info": "rocm-7.10.0a20251120.dist-info/METADATA,,\nRECORD,,\n",
+                "rocm_sdk_core-7.10.0a20251120.dist-info": "bin/amd-smi,sha256=ij-kb96,250\n",
+                "rocm_sdk_libraries_gfx120x_all-7.10.0a20251120.dist-info": "lib/libhipblaslt.so,sha256=AAAA,1\n",
+                "numpy-2.1.0.dist-info": "numpy/__init__.py,sha256=BBBB,2\n",
+                "rocm_sdk_devel-7.10.0a20251120.dist-info": None,      # no RECORD: not counted
+            })
+            got = self.read(sp)
+        self.assertEqual(sorted(got), ["rocm", "rocm_sdk_core", "rocm_sdk_libraries_gfx120x_all"])
+        self.assertEqual(got["rocm"][0], "7.10.0a20251120")
+        want = hashlib.sha256(b"bin/amd-smi,sha256=ij-kb96,250\n").hexdigest()
+        self.assertEqual(got["rocm_sdk_core"][1], want)
+
+    def test_different_bytes_installed_are_a_different_record(self):
+        versions = {}
+        for record in ("lib/libhipblaslt.so,sha256=AAAA,1\n", "lib/libhipblaslt.so,sha256=CCCC,1\n"):
+            with tempfile.TemporaryDirectory() as tmp:
+                sp = self.sitepackages(tmp, {"rocm_sdk_libraries_gfx120x_all-7.10.0a20251120.dist-info": record})
+                versions[record] = self.read(sp)["rocm_sdk_libraries_gfx120x_all"][1]
+        self.assertNotEqual(*versions.values())
+
+    def test_no_site_packages_says_nothing_rather_than_failing(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            self.assertEqual(self.read(Path(tmp) / "site-packages"), {})
+
+    def test_the_stamp_carries_the_record_and_the_fallback_warning(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            sp = self.sitepackages(tmp, {"rocm-7.10.0a20251120.dist-info": "RECORD,,\n"})
+            with mock.patch.object(sys, "path", [str(sp)]):
+                plain = setup.rocm_stamp("7.10.0a20251120", "https://rocm.nightlies.amd.com/v2/gfx120X-all/")
+                fell = setup.rocm_stamp("7.13.0a20260515", "https://rocm.nightlies.amd.com/v2/gfx120X-all/",
+                                        "ROCm 7.10.0a20251120 is not on this index any more")
+        self.assertEqual(plain["installs"]["rocm"][0], "7.10.0a20251120")
+        self.assertNotIn("note", plain)
+        self.assertEqual(fell["version"], "7.13.0a20260515")
+        self.assertIn("not on this index", fell["note"])
+        self.assertTrue(fell["installs"])
+
+
+class RocmInstalledAgainstTheStamp(unittest.TestCase):
+    """rocm_root when the pinned wheel version is already the recorded one (no install to do): .venv's ROCm is checked
+    against what the stamp recorded, and a stamp written before the record existed is filled in without reinstalling."""
+
+    FAMILY = setup.rocm_family(setup.rocm_index("gfx1201"))
+    INDEX = setup.rocm_index("gfx1201")
+    PIN = setup.ROCM_FAMILY_PINS.get(FAMILY, setup.ROCM_VERSION_DEFAULT)
+
+    def rocm_root_here(self, tmp, stamp, dists):
+        """Run rocm_root with a fake .venv (bin/rocm-sdk, site-packages with RECORDs), a fake `rocm-sdk path --root`
+        answer, an empty ROCM_PATH (no system ROCm) and the stamp of `tmp` written as `stamp`.
+        Returns (the stamp on disk now, what setup said)."""
+        tmp = Path(tmp)
+        root = tmp / "sdk-root"
+        (root / "llvm" / "bin").mkdir(parents=True)
+        (root / "llvm" / "bin" / "clang++").write_text("")
+        (root / "lib").mkdir()
+        sp = tmp / "site-packages"
+        for name, record in dists.items():
+            (sp / name).mkdir(parents=True)
+            (sp / name / "RECORD").write_text(record, encoding="utf-8")
+        exe = tmp / "bin" / "python"
+        exe.parent.mkdir(parents=True)
+        exe.write_text("")
+        (exe.parent / "rocm-sdk").mkdir()
+        stamp_file = tmp / ".strata-rocm.json"
+        if stamp is not None:
+            stamp_file.write_text(json.dumps(stamp), encoding="utf-8")
+        said = []
+        saved = setup.os.environ.get("ROCM_PATH")
+        setup.os.environ["ROCM_PATH"] = str(tmp / "no-system-rocm")
+        try:
+            with mock.patch.object(setup.sys, "prefix", str(tmp)), \
+                    mock.patch.object(setup.sys, "executable", str(exe)), \
+                    mock.patch.object(setup.sys, "path", [str(sp)]), \
+                    mock.patch.object(setup, "ROCM_VERSION_OVERRIDE", None), \
+                    mock.patch.object(setup, "out", lambda cmd: str(root)), \
+                    mock.patch.object(setup, "ok", lambda msg="": said.append(msg)), \
+                    mock.patch.object(setup, "say", lambda msg="": said.append(msg)), \
+                    mock.patch.object(setup, "warn", lambda msg="": said.append(msg)):
+                setup.rocm_root(["gfx1201"])
+        finally:
+            if saved is None:
+                del setup.os.environ["ROCM_PATH"]
+            else:
+                setup.os.environ["ROCM_PATH"] = saved
+        return json.loads(stamp_file.read_text(encoding="utf-8")), "\n".join(said)
+
+    def stamp_and_dists(self, tmp, record="lib/libhipblaslt.so,sha256=AAAA,1\n", installs=True, digest=None):
+        """(stamp, dists) for a .venv holding one `rocm_sdk_libraries_gfx120x_all` wheel, and what its RECORD hashes to."""
+        dist = "rocm_sdk_libraries_gfx120x_all-" + self.PIN + ".dist-info"
+        want = hashlib.sha256(record.encode()).hexdigest()
+        stamp = {"version": self.PIN, "index": self.INDEX}
+        if installs:
+            stamp["installs"] = {"rocm_sdk_libraries_gfx120x_all": [self.PIN, digest or want]}
+        return stamp, {dist: record}, want
+
+    def test_installed_bytes_matching_the_stamp_say_nothing(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            stamp, dists, _ = self.stamp_and_dists(tmp)
+            now, said = self.rocm_root_here(tmp, stamp, dists)
+        self.assertNotIn("is not what setup installed", said)
+        self.assertEqual(now, stamp)
+
+    def test_changed_installed_bytes_are_warned_about_by_name(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            stamp, dists, _ = self.stamp_and_dists(tmp, digest="0" * 64)      # the stamp records other bytes
+            now, said = self.rocm_root_here(tmp, stamp, dists)
+        self.assertIn("is not what setup installed", said)
+        self.assertIn("rocm_sdk_libraries_gfx120x_all", said)
+        self.assertNotIn("Installing ROCm", said)                               # warned, not reinstalled
+
+    def test_a_dist_installed_without_being_recorded_is_warned_about(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            stamp, dists, _ = self.stamp_and_dists(tmp)
+            stamp["installs"] = {"rocm": [self.PIN, "0" * 64]}      # a record that does not know this dist is installed
+            _, said = self.rocm_root_here(tmp, stamp, dists)
+        self.assertIn("is not what setup installed", said)
+        self.assertIn("rocm_sdk_libraries_gfx120x_all", said)
+        self.assertIn("rocm", said)
+
+    def test_an_old_stamp_is_filled_in_without_reinstalling(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            stamp, dists, want = self.stamp_and_dists(tmp, installs=False)
+            now, said = self.rocm_root_here(tmp, stamp, dists)
+        self.assertNotIn("is not what setup installed", said)
+        self.assertNotIn("Installing ROCm", said)
+        self.assertEqual(now["installs"], {"rocm_sdk_libraries_gfx120x_all": [self.PIN, want]})
+
+    def test_drift_lists_changed_missing_and_extra(self):
+        recorded = {"rocm": ["1", "a"], "rocm_sdk_core": ["1", "b"], "rocm_sdk_devel": ["1", "c"]}
+        now = {"rocm": ["1", "a"], "rocm_sdk_core": ["1", "z"], "extra": ["1", "d"]}
+        self.assertEqual(setup.rocm_drift({"installs": recorded}, now),
+                         ["extra", "rocm_sdk_core", "rocm_sdk_devel"])
+        self.assertEqual(setup.rocm_drift({}, {}), [])
+
+
